{
  "name": "anthrodocs",
  "version": "1.0.1",
  "description": "Redoc-style API documentation renderer for Next.js — SSR-friendly",
  "license": "MIT",
  "type": "module",
  "main": "./dist/anthrodocs.js",
  "types": "./dist/anthrodocs.d.ts",
  "exports": {
    ".": {
      "import": "./dist/anthrodocs.js",
      "types": "./dist/anthrodocs.d.ts"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "dev": "next dev -p 3333",
    "build": "next build",
    "build:lib": "tsup",
    "start": "next start -p 3333",
    "prepublishOnly": "npm run build:lib"
  },
  "peerDependencies": {
    "next": "^14 || ^15",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "dependencies": {
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "next": "^14.2.0",
    "postcss": "^8.4.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tailwindcss": "^3.4.0",
    "tsup": "^8.5.1",
    "typescript": "^5.4.0"
  }
}
